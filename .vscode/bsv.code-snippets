    "prefix": "tenum",
    "body": [
      "typedef enum {",
      "    ${1:S_IDLE},",
      "    ${2:S_RUN}",
      "} ${3:State} deriving (Bits, Eq);"
    ],
    "description": "Define a BSV enum with deriving (Bits, Eq)"
  },
  "BSV Struct Typedef": {
    "prefix": "tstruct",
    "body": [
      "typedef struct {",
      "    Bit#(${1:8}) ${2:field1};",
